{
    "manifest_version": 3,
    "name": "phpMyAdmin Tools",
    "description": "Quality-of-life improvements for phpMyAdmin: a ⌘K / Alt+K palette to jump to any database or table, and ⌥←/→ to cycle through tabs.",
    "version": "0.1.2",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "palette-styles.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
